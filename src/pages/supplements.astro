---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Supplements – CraveSmart"
  description="There are currently no supplements available on CraveSmart. Browse the recipe collection instead."
  noindex={true}
  showAds={false}
>
  <section class="bg-white text-gray-900 py-16 md:py-24 text-center">
    <div class="container mx-auto px-4 max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-heading font-bold mb-6">Supplements</h1>
      <p class="text-lg text-gray-700 mb-8">There are currently no supplements available here.</p>
      <a href="/recipes/" class="inline-block rounded-full bg-gray-900 px-8 py-4 font-semibold text-white hover:bg-gray-800">Browse CraveSmart recipes</a>
    </div>
  </section>
</BaseLayout>
