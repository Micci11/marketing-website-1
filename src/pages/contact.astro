---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact – CraveSmart" 
  description="Get in touch with CraveSmart for questions, feedback, or collaborations."
>
  <section class="bg-white text-gray-900 py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-4xl">
      <h1 class="text-5xl md:text-6xl font-heading font-bold mb-6 text-center">
        Contact Us
      </h1>
      <p class="text-xl md:text-2xl text-center mb-12 text-gray-700 max-w-3xl mx-auto">
        Have a question, feedback, or want to collaborate? We'd love to hear from you.
      </p>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Form -->
        <div>
          <p id="contact-success" role="status" hidden class="mb-6 rounded-xl bg-green-50 p-4 text-green-900">Thank you. Your message was submitted.</p>
          <form action="/api/contact" method="POST" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-tiffany focus:ring-2 focus:ring-tiffany/30 focus:outline-none px-4 py-3 bg-white transition"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-tiffany focus:ring-2 focus:ring-tiffany/30 focus:outline-none px-4 py-3 bg-white transition"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-tiffany focus:ring-2 focus:ring-tiffany/30 focus:outline-none px-4 py-3 bg-white transition"
              ></textarea>
            </div>

            <button
              type="submit"
              class="bg-tiffany text-white px-8 py-4 rounded-full font-semibold hover:bg-tiffany-dark transition w-full md:w-auto button-hover"
            >
              Send Message
            </button>
          </form>
        </div>

        <aside class="space-y-6">
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">Recipe questions and corrections</h2>
            <p class="text-gray-700">Use the form to tell us which recipe you made, the step you have a question about, and any ingredient substitutions. Your appliance and portion size can also help explain a cooking result.</p>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">Other inquiries</h2>
            <p class="text-gray-700">For collaborations or other requests, include the relevant details in your message.</p>
          </div>
          <p class="text-sm text-gray-600">Please avoid including sensitive information. Read our <a href="/privacy" class="underline">privacy policy</a> for how contact messages are handled.</p>
        </aside>
      </div>
    </div>
  </section>
<script is:inline>
  const contactSuccess = document.getElementById('contact-success');
  if (contactSuccess && new URLSearchParams(window.location.search).get('success') === 'true') {
    contactSuccess.hidden = false;
  }
</script>
</BaseLayout>
