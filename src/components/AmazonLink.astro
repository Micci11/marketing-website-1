---
import { getAmazonProduct, getAmazonUrl } from '../lib/amazon.mjs';

interface Props {
  product: string;
}

const { product } = Astro.props;
const details = getAmazonProduct(product);
const href = getAmazonUrl(product);
---

<a href={href} target="_blank" rel="sponsored nofollow noopener noreferrer"><slot>{details.label}</slot></a>
